file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${EXE}" forward --config "${SOURCE}/examples/forward/normal.toml" --output "${WORK}/normal.txt" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "normal forward exit ${status}")
endif()
file(STRINGS "${WORK}/normal.txt" rows REGEX "^[0-9]")
list(LENGTH rows n)
if(NOT n EQUAL 7)
  message(FATAL_ERROR "row loss")
endif()
execute_process(COMMAND "${EXE}" forward --config "${SOURCE}/examples/forward/missing.toml" --output "${WORK}/missing.txt" RESULT_VARIABLE status)
if(NOT status EQUAL 2)
  message(FATAL_ERROR "missing root must exit 2")
endif()
file(READ "${WORK}/missing.txt" text)
if(NOT text MATCHES "nan missing_or_unresolved")
  message(FATAL_ERROR "missing root must be explicit NaN")
endif()
file(WRITE "${WORK}/bad.toml" "[model]\ndepth=[0.0]\nvs=[0.0]\nvp=[1.0]\nrho=[2.0]\n[queries]\nfrequency_hz=[1.0]\nmode=[0]\n")
execute_process(COMMAND "${EXE}" forward --config "${WORK}/bad.toml" --output "${WORK}/bad.txt" RESULT_VARIABLE status)
if(NOT status EQUAL 1 OR EXISTS "${WORK}/bad.txt")
  message(FATAL_ERROR "invalid model not rejected cleanly")
endif()
execute_process(COMMAND "${EXE}" forward --config "${WORK}/bad.toml" --output "${WORK}/bad.toml" RESULT_VARIABLE status)
if(NOT status EQUAL 1)
  message(FATAL_ERROR "input overwrite not rejected")
endif()
